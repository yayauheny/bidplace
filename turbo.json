{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": [
    ".env.example",
    "package.json",
    "pnpm-workspace.yaml",
    "tsconfig.json"
  ],
  "tasks": {
    "generate": {
      "cache": true,
      "outputs": ["src/generated/prisma/**"]
    },
    "build": {
      "dependsOn": ["^build", "generate"],
      "outputs": ["dist/**"]
    },
    "clean": {
      "cache": false
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "typecheck": {
      "dependsOn": ["^build", "^typecheck", "generate"]
    },
    "test": {
      "dependsOn": ["generate"],
      "cache": false
    }
  }
}
