{
  "name": "@bidplace/api",
  "private": true,
  "scripts": {
    "dev": "pnpm exec turbo run build --filter=@bidplace/database && nest start --watch",
    "build": "nest build && node scripts/copy-legal.mjs",
    "start": "node dist/main.js",
    "lint": "eslint .",
    "test": "vitest run",
    "test:integration": "NODE_ENV=test vitest run --config vitest.integration.config.ts",
    "typecheck": "tsc --noEmit -p tsconfig.typecheck.json",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1127.0",
    "@bidplace/config": "workspace:*",
    "@bidplace/contracts": "workspace:*",
    "@bidplace/database": "workspace:*",
    "@nestjs/common": "^10.4.2",
    "@nestjs/core": "^10.4.2",
    "@nestjs/platform-express": "^10.4.2",
    "argon2": "^0.44.0",
    "connect-pg-simple": "10.0.0",
    "express-session": "1.19.0",
    "nodemailer": "^7.0.13",
    "openid-client": "6.8.8",
    "pg": "8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "sharp": "^0.35.3",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.2",
    "@nestjs/schematics": "^10.1.4",
    "@types/connect-pg-simple": "^7.0.3",
    "@types/express": "^4.17.25",
    "@types/express-session": "^1.19.0",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.23.1",
    "typescript": "5.9.3"
  }
}
