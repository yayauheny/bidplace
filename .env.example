# Schema-derived local template; Cloudflare uses Wrangler vars + Secrets.
# Supply DATABASE_URL and JWT_SECRET locally. Never commit actual values.
NODE_ENV=development
APP_ENV=local
DATABASE_URL=
JWT_SECRET=
API_PORT=3001
API_URL=http://localhost:3001
CORS_ORIGIN=http://localhost:8081
TRUST_PROXY=false
RATE_LIMIT_MAX_BUCKETS=10000
RATE_LIMIT_CLEANUP_INTERVAL_MS=60000
LOT_IMAGE_MAX_FILES=8
LOT_IMAGE_MAX_FILE_BYTES=5242880
LOT_IMAGE_MAX_TOTAL_BYTES=41943040
# SMTP_HOST=
# SMTP_PORT=587
SMTP_SECURE=false
# SMTP_AUTH_MODE=login
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_FROM=
PASSWORD_RESET_URL_BASE=http://localhost:8081
# SERVICE_RULES_OWNER=
# SERVICE_RULES_CONTACT=
# SERVICE_RULES_TEXT=
# TEST_EMAIL_FILE=
TEST_EMAIL_BYPASS=false
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_WEBAPP_URL=
ANALYTICS_INGEST_ENABLED=true
MEDIA_STORAGE_PROVIDER=postgres
# S3_ENDPOINT=
# S3_REGION=auto
# S3_BUCKET=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_PUBLIC_BUCKET=
# MEDIA_PUBLIC_BASE_URL=
# CLOUDFLARE_ZONE_ID=
# CLOUDFLARE_CACHE_TOKEN=
EXPO_PUBLIC_API_URL=http://localhost:3001
EXPO_PUBLIC_APP_ENV=local
EXPO_PUBLIC_ANALYTICS_ENABLED=true
