# Shared
NODE_ENV=development
APP_ENV=local

# Local/test database. Production Compose injects its internal PostgreSQL URL.
DATABASE_URL=postgresql://auction:auction@localhost:5432/bidplace?schema=public

# Backend
API_PORT=3001
API_URL=http://localhost:3001
CORS_ORIGIN=http://localhost:8081
# Production profile (NODE_ENV=production with APP_ENV=production|staging) requires at least 32 characters.
JWT_SECRET=dev-jwt-secret-replace-me-32-chars
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_AUTH_MODE=none
SMTP_FROM=bidplace@example.com
SMTP_USERNAME=
SMTP_PASSWORD=
PASSWORD_RESET_URL_BASE=http://localhost:8081/reset-password
SERVICE_RULES_OWNER=bidplace
SERVICE_RULES_CONTACT=support@bidplace.test
SERVICE_RULES_TEXT=bidplace MVP rules ...
TEST_EMAIL_BYPASS=false
TELEGRAM_BOT_TOKEN=replace-me-later
TELEGRAM_WEBAPP_URL=http://localhost:8081/tma

# Frontend public env
# NOTE: Ensure EXPO_PUBLIC_API_URL hostname exactly matches the browser hostname
# (e.g. use localhost for both, or 127.0.0.1 for both) to prevent SameSite cookie issues on SPA refresh.
EXPO_PUBLIC_API_URL=http://localhost:3001

# Media storage
# Local and test profiles may use PostgreSQL media storage. Production and staging
# profiles require s3 and every S3_* value below.
MEDIA_STORAGE_PROVIDER=postgres
S3_ENDPOINT=https://s3.example.invalid
S3_REGION=us-east-1
S3_BUCKET=bidplace-media-example
S3_ACCESS_KEY_ID=replace-with-s3-access-key
S3_SECRET_ACCESS_KEY=replace-with-s3-secret

# Local Testing & Seeding
SEED_ADMIN_EMAIL=admin@bidplace.test
# Password hash for the local demo admin. Do NOT put raw passwords here.
SEED_ADMIN_PASSWORD_HASH='$argon2id$v=19$m=65536,t=3,p=4$Z29kZHNhbHRzYWx0$E2lO6X/nJpB6v2x7a9rQp1yJ8W3A2b5V5d0v4f9w5Xw'
TEST_EMAIL_FILE=.email.jsonl
