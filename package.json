{
  "name": "bidplace",
  "private": true,
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "db:generate": "pnpm --filter @bidplace/database db:generate",
    "db:migrate": "pnpm --filter @bidplace/database db:migrate",
    "db:seed": "pnpm --filter @bidplace/database db:seed",
    "db:reset:demo": "echo '\\n⚠️  ВНИМАНИЕ: База данных очищается!\\n' && pnpm --filter @bidplace/database db:seed",
    "test:unit": "pnpm --filter @bidplace/api test && pnpm --filter @bidplace/contracts test",
    "test:integration": "pnpm --filter @bidplace/api test:integration",
    "verify": "pnpm db:generate && pnpm typecheck && pnpm lint && pnpm test:unit && pnpm test:integration && pnpm build",
    "ops:backup": "bash scripts/ops/backup-db.sh",
    "ops:restore": "bash scripts/ops/restore-db.sh",
    "ops:verify-restore": "pnpm --filter @bidplace/database build && node scripts/ops/verify-restore-integrity.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "clean": "turbo clean && rm -rf node_modules",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@typescript-eslint/eslint-plugin": "^8.23.0",
    "@typescript-eslint/parser": "^8.23.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-import-resolver-typescript": "^3.7.0",
    "eslint-plugin-import": "^2.31.0",
    "prettier": "^3.5.3",
    "turbo": "^2.4.4",
    "typescript": "^5.8.3",
    "vitest": "^4.1.10",
    "zod": "^3.24.2"
  }
}
