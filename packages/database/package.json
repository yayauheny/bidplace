{
  "name": "@bidplace/database",
  "private": true,
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "generate": "node ./node_modules/prisma/build/index.js generate --schema=prisma/schema.prisma",
    "db:generate": "pnpm run generate",
    "migrate": "node --env-file ../../.env ./node_modules/prisma/build/index.js migrate deploy --schema=prisma/schema.prisma",
    "db:migrate": "pnpm run migrate",
    "seed": "pnpm run generate && pnpm run build && node --env-file ../../.env prisma/seed.js",
    "db:seed": "pnpm run seed",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.typecheck.json --noEmit",
    "test": "vitest run",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "argon2": "^0.44.0"
  },
  "devDependencies": {
    "prisma": "6.19.3",
    "typescript": "5.9.3"
  }
}
