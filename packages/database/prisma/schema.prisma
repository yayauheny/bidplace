generator client {
  provider      = "prisma-client"
  output        = "../src/generated/prisma"
  binaryTargets = ["native", "debian-openssl-3.0.x", "linux-arm64-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum SellerProfileStatus {
  PENDING_REVIEW
  APPROVED
  CHANGES_REQUESTED
  REJECTED
  SUSPENDED
}

enum ProductStatus {
  DRAFT
  PENDING_REVIEW
  CHANGES_REQUESTED
  APPROVED
  REJECTED
  ARCHIVED
}

enum ListingType {
  AUCTION
}

enum ListingStatus {
  DRAFT
  SCHEDULED
  LIVE
  ENDED
  CANCELLED
}

enum OrderStatus {
  PENDING_CONTACT
  CONTACTED
  COMPLETED
  HANDOFF_FAILED
  CANCELLED
}

enum OrderCancellationReason {
  BUYER_DECLINED
  BUYER_UNREACHABLE
  ADMIN_CANCELLED
}

enum HandoffContactType {
  TELEGRAM
  PHONE
  INSTAGRAM
}

enum HandoffInitiator {
  BUYER_CONTACTS_SELLER
  SELLER_CONTACTS_BUYER
}

enum AuditTargetType {
  SELLER_PROFILE
  PRODUCT
  ORDER
  LISTING
  USER
}

model User {
  id                String                @id @default(uuid()) @db.Uuid
  email             String                @unique @db.VarChar(255)
  passwordHash      String                @map("password_hash") @db.VarChar(255)
  phone             String?               @unique @db.VarChar(32)
  emailVerifiedAt   DateTime?             @map("email_verified_at")
  phoneVerifiedAt   DateTime?             @map("phone_verified_at")
  displayName       String                @map("display_name") @db.VarChar(120)
  role              String                @default("user")
  status            String                @default("active")
  sessionVersion    Int                   @default(0) @map("session_version")
  createdAt         DateTime              @default(now()) @map("created_at")
  updatedAt         DateTime              @updatedAt @map("updated_at")
  sellerProfile     SellerProfile?
  bids              Bid[]
  buyerOrders       Order[]               @relation("OrderBuyer")
  sellerOrders      Order[]               @relation("OrderSeller")
  phoneCodes        PhoneVerificationCode[]
  emailCodes        EmailVerificationCode[]
  passwordResetTokens PasswordResetToken[]
  termsAcceptances   TermsAcceptance[]
  auditEvents       AuditEvent[]          @relation("AuditActor")

  @@map("users")
}

model SellerProfile {
  id                  String              @id @default(uuid()) @db.Uuid
  userId              String              @unique @map("user_id") @db.Uuid
  slug                String              @unique @db.VarChar(120)
  sellerType          String              @map("seller_type")
  discipline          String              @default("Автор") @db.VarChar(160)
  fullName            String              @map("full_name") @db.VarChar(160)
  country             String              @db.VarChar(80)
  profilePhotoMimeType String              @map("profile_photo_mime_type") @db.VarChar(100)
  profilePhotoByteLength Int              @map("profile_photo_byte_length")
  profilePhotoChecksum String              @map("profile_photo_checksum") @db.Char(64)
  profilePhotoData    Bytes               @map("profile_photo_data")
  socialLink          String              @map("social_link") @db.VarChar(255)
  telegramUrl         String?             @map("telegram_url") @db.VarChar(255)
  instagramUrl        String?             @map("instagram_url") @db.VarChar(255)
  websiteUrl          String?             @map("website_url") @db.VarChar(255)
  shortDescription    String              @map("short_description") @db.Text
  handoffContactType  HandoffContactType? @map("handoff_contact_type")
  handoffContactValue String?             @map("handoff_contact_value") @db.VarChar(255)
  handoffInitiator    HandoffInitiator    @default(BUYER_CONTACTS_SELLER) @map("handoff_initiator")
  status              SellerProfileStatus @default(PENDING_REVIEW)
  createdAt           DateTime            @default(now()) @map("created_at")
  updatedAt           DateTime            @updatedAt @map("updated_at")
  user                User                @relation(fields: [userId], references: [id], onDelete: Restrict)
  products            Product[]

  @@map("seller_profiles")
}

model Category {
  id          String    @id @default(uuid()) @db.Uuid
  slug        String    @unique @db.VarChar(120)
  name        String    @db.VarChar(160)
  description String?   @db.Text
  products    Product[]

  @@map("categories")
}

model Product {
  id              String        @id @default(uuid()) @db.Uuid
  publicId        String        @unique @map("public_id") @db.VarChar(16)
  sellerProfileId String        @map("seller_profile_id") @db.Uuid
  categoryId      String?       @map("category_id") @db.Uuid
  title           String?       @db.VarChar(200)
  story           String?       @db.Text
  technique       String?       @db.Text
  materials       String?       @db.Text
  dimensions      String?       @db.VarChar(240)
  weight          String?       @db.VarChar(120)
  year            Int?
  condition       String?       @db.VarChar(120)
  uniqueness      String?       @db.VarChar(240)
  provenance      String?       @db.Text
  city            String?       @db.VarChar(160)
  packaging       String?       @db.Text
  deliveryInfo    String?       @map("delivery_info") @db.Text
  creationIntro   String?       @map("creation_intro") @db.Text
  publishedAt     DateTime?     @map("published_at")
  status          ProductStatus @default(DRAFT)
  editingRevisionId String?     @unique @map("editing_revision_id") @db.Uuid
  publishedRevisionId String?   @unique @map("published_revision_id") @db.Uuid
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")
  sellerProfile   SellerProfile @relation(fields: [sellerProfileId], references: [id], onDelete: Restrict)
  category        Category?     @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  images          ProductImage[]
  creationSteps   ProductCreationStep[]
  listings        Listing[]
  revisions       ProductRevision[] @relation("ProductRevisions")
  editingRevision ProductRevision? @relation("ProductEditingRevision", fields: [editingRevisionId], references: [id], onDelete: Restrict)
  publishedRevision ProductRevision? @relation("ProductPublishedRevision", fields: [publishedRevisionId], references: [id], onDelete: Restrict)

  @@index([sellerProfileId, status])
  @@map("products")
}

model ProductRevision {
  id            String        @id @default(uuid()) @db.Uuid
  productId     String        @map("product_id") @db.Uuid
  version       Int
  status        ProductStatus @default(DRAFT)
  categoryId    String?       @map("category_id") @db.Uuid
  title         String?       @db.VarChar(200)
  story         String?       @db.Text
  technique     String?       @db.Text
  materials     String?       @db.Text
  dimensions    String?       @db.VarChar(240)
  weight        String?       @db.VarChar(120)
  year          Int?
  condition     String?       @db.VarChar(120)
  uniqueness    String?       @db.VarChar(240)
  provenance    String?       @db.Text
  city          String?       @db.VarChar(160)
  packaging     String?       @db.Text
  deliveryInfo  String?       @map("delivery_info") @db.Text
  creationIntro String?       @map("creation_intro") @db.Text
  submittedAt   DateTime?     @map("submitted_at")
  reviewedAt    DateTime?     @map("reviewed_at")
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")
  product       Product       @relation("ProductRevisions", fields: [productId], references: [id], onDelete: Cascade)
  editingFor    Product?      @relation("ProductEditingRevision")
  publishedFor  Product?      @relation("ProductPublishedRevision")
  images        ProductRevisionImage[]

  @@unique([productId, version])
  @@index([productId, status])
  @@map("product_revisions")
}

model ProductImage {
  id         String   @id @default(uuid()) @db.Uuid
  productId  String   @map("product_id") @db.Uuid
  position   Int
  mimeType   String   @map("mime_type") @db.VarChar(100)
  byteLength Int      @map("byte_length")
  data       Bytes
  checksum   String   @db.Char(64)
  width      Int?
  height     Int?
  createdAt  DateTime @default(now()) @map("created_at")
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  revisions  ProductRevisionImage[]

  @@index([productId])
  @@unique([productId, position])
  @@map("product_images")
}

model ProductRevisionImage {
  revisionId String          @map("revision_id") @db.Uuid
  imageId    String          @map("image_id") @db.Uuid
  position   Int
  revision   ProductRevision @relation(fields: [revisionId], references: [id], onDelete: Cascade)
  image      ProductImage    @relation(fields: [imageId], references: [id], onDelete: Restrict)

  @@id([revisionId, imageId])
  @@unique([revisionId, position])
  @@index([imageId])
  @@map("product_revision_images")
}

model ProductCreationStep {
  id         String   @id @default(uuid()) @db.Uuid
  productId  String   @map("product_id") @db.Uuid
  position   Int
  title      String   @db.VarChar(200)
  body       String   @db.Text
  mimeType   String?  @map("mime_type") @db.VarChar(100)
  byteLength Int?     @map("byte_length")
  data       Bytes?
  checksum   String?  @db.Char(64)
  width      Int?
  height     Int?
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, position])
  @@index([productId])
  @@map("product_creation_steps")
}

model Listing {
  id             String        @id @default(uuid()) @db.Uuid
  productId      String        @map("product_id") @db.Uuid
  type           ListingType   @default(AUCTION)
  status         ListingStatus @default(DRAFT)
  currency       String        @default("BYN") @db.Char(3)
  startsAt       DateTime      @map("starts_at")
  originalEndsAt DateTime      @map("original_ends_at")
  endsAt         DateTime      @map("ends_at")
  currentPrice   Decimal       @map("current_price") @db.Decimal(12, 2)
  bidCount       Int           @default(0) @map("bid_count")
  closedAt       DateTime?     @map("closed_at")
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")
  product        Product       @relation(fields: [productId], references: [id], onDelete: Restrict)
  auctionRules   AuctionRules?
  bids           Bid[]
  orders         Order[]

  @@index([status, startsAt])
  @@index([status, endsAt])
  @@map("listings")
}

model AuctionRules {
  listingId                    String   @id @map("listing_id") @db.Uuid
  startPrice                   Decimal  @map("start_price") @db.Decimal(12, 2)
  incrementPolicyCode          String   @default("MVP_BYN_V1") @map("increment_policy_code") @db.VarChar(40)
  softCloseWindowSeconds       Int      @default(60) @map("soft_close_window_seconds")
  softCloseExtensionSeconds    Int      @default(60) @map("soft_close_extension_seconds")
  softCloseMaxTotalSeconds     Int      @default(600) @map("soft_close_max_total_seconds")
  listing                      Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@map("auction_rules")
}

model Bid {
  id             String   @id @default(uuid()) @db.Uuid
  listingId      String   @map("listing_id") @db.Uuid
  bidderUserId   String   @map("bidder_user_id") @db.Uuid
  idempotencyKey String   @map("idempotency_key") @db.VarChar(80)
  amount         Decimal  @db.Decimal(12, 2)
  createdAt      DateTime @default(now()) @map("created_at")
  listing        Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  bidderUser     User     @relation(fields: [bidderUserId], references: [id], onDelete: Restrict)
  sourceOrder    Order?

  @@unique([bidderUserId, idempotencyKey])
  @@index([listingId, amount, createdAt, id])
  @@index([listingId, createdAt])
  @@map("bids")
}

model Order {
  id                 String                   @id @default(uuid()) @db.Uuid
  publicId           String                   @unique @map("public_id") @db.VarChar(16)
  listingId          String                   @map("listing_id") @db.Uuid
  sellerId           String                   @map("seller_id") @db.Uuid
  buyerId            String                   @map("buyer_id") @db.Uuid
  sourceBidId        String                   @unique @map("source_bid_id") @db.Uuid
  finalAmount        Decimal                  @map("final_amount") @db.Decimal(12, 2)
  contactDueAt       DateTime                 @map("contact_due_at")
  sellerHandoffType  HandoffContactType       @map("seller_handoff_type")
  sellerHandoffValue String                   @map("seller_handoff_value") @db.VarChar(255)
  buyerEmailAtClose  String                   @map("buyer_email_at_close") @db.VarChar(255)
  handoffInitiator   HandoffInitiator         @map("handoff_initiator")
  snapshotTitle      String?                  @map("snapshot_title") @db.VarChar(200)
  snapshotCurrency   String?                  @map("snapshot_currency") @db.Char(3)
  snapshotProductPublicId String?             @map("snapshot_product_public_id") @db.VarChar(16)
  status             OrderStatus              @default(PENDING_CONTACT)
  cancellationReason OrderCancellationReason? @map("cancellation_reason")
  createdAt          DateTime                 @default(now()) @map("created_at")
  updatedAt          DateTime                 @updatedAt @map("updated_at")
  listing            Listing                  @relation(fields: [listingId], references: [id], onDelete: Restrict)
  seller             User                     @relation("OrderSeller", fields: [sellerId], references: [id], onDelete: Restrict)
  buyer              User                     @relation("OrderBuyer", fields: [buyerId], references: [id], onDelete: Restrict)
  sourceBid          Bid                      @relation(fields: [sourceBidId], references: [id], onDelete: Restrict)

  @@index([listingId])
  @@index([sellerId, status])
  @@index([buyerId, status])
  @@map("orders")
}

model PhoneVerificationCode {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  codeHash  String   @map("code_hash") @db.Char(64)
  expiresAt DateTime @map("expires_at")
  usedAt    DateTime? @map("used_at")
  attempts  Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("phone_verification_codes")
}

model EmailVerificationCode {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  codeHash  String   @map("code_hash") @db.Char(64)
  expiresAt DateTime @map("expires_at")
  usedAt    DateTime? @map("used_at")
  attempts  Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("email_verification_codes")
}

model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash") @db.Char(64)
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("password_reset_tokens")
}

model TermsAcceptance {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  rulesVersion String  @map("rules_version") @db.VarChar(40)
  acceptedAt  DateTime @map("accepted_at")
  createdAt   DateTime @default(now()) @map("created_at")
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, rulesVersion])
  @@index([userId, acceptedAt])
  @@map("terms_acceptances")
}

model AuditEvent {
  id          String          @id @default(uuid()) @db.Uuid
  actorUserId String?         @map("actor_user_id") @db.Uuid
  targetType  AuditTargetType @map("target_type")
  targetId    String          @map("target_id") @db.Uuid
  oldStatus   String?         @map("old_status") @db.VarChar(64)
  newStatus   String?         @map("new_status") @db.VarChar(64)
  reason      String?         @db.Text
  createdAt   DateTime        @default(now()) @map("created_at")

  actor User? @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([targetType, targetId, createdAt])
  @@map("audit_events")
}

model AnalyticsEvent {
  id               String    @id @default(uuid()) @db.Uuid
  eventName        String    @map("event_name") @db.VarChar(64)
  anonymousId      String    @map("anonymous_id") @db.Uuid
  userId           String?   @map("user_id") @db.Uuid
  properties       Json      @default("{}")
  platform         String?   @db.VarChar(32)
  appVersion       String?   @map("app_version") @db.VarChar(32)
  environment      String    @db.VarChar(32)
  clientCapturedAt DateTime? @map("client_captured_at")
  createdAt        DateTime  @default(now()) @map("created_at")

  @@index([eventName, createdAt])
  @@index([anonymousId, createdAt])
  @@index([userId, createdAt])
  @@index([createdAt])
  @@map("analytics_events")
}

model AcquisitionAttribution {
  id          String    @id @default(uuid()) @db.Uuid
  anonymousId String    @unique @map("anonymous_id") @db.Uuid
  userId      String?   @unique @map("user_id") @db.Uuid
  source      String?   @db.VarChar(120)
  medium      String?   @db.VarChar(120)
  campaign    String?   @db.VarChar(120)
  content     String?   @db.VarChar(120)
  referrer    String?   @db.VarChar(512)
  landingPath String?   @map("landing_path") @db.VarChar(512)
  capturedAt  DateTime  @map("captured_at")
  linkedAt    DateTime? @map("linked_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@index([source, capturedAt])
  @@index([capturedAt])
  @@map("acquisition_attributions")
}
