enum CatalogTermRole {
  MATERIAL
  TECHNIQUE
}

enum CatalogProposalKind {
  CATEGORY
  MATERIAL
  TECHNIQUE
}

enum CatalogProposalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum StoryBlockType {
  HEADING
  PARAGRAPH
  IMAGE
}

model SellerProfileRevisionDirection {
  revisionId String @map("revision_id") @db.Uuid
  categoryId String @map("category_id") @db.Uuid
  position   Int
  revision   SellerProfileRevision @relation(fields: [revisionId], references: [id], onDelete: Cascade)
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)

