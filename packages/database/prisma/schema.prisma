generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  admin
  user
}

enum SellerType {
  creator
  influencer
}

enum SellerStatus {
  draft
  active
  restricted
  suspended
}

enum LotStatus {
  draft
  published
  sold
  hidden
  archived
}

enum AuctionStatus {
  draft
  scheduled
  active
  ended
  sold
  cancelled
  failed
  hidden
}

enum BidStatus {
  active
  winning
  outbid
  won
  lost
  cancelled
  invalid
}

model User {
  id            String         @id @default(uuid()) @db.Uuid
  email         String         @unique @db.VarChar(255)
  passwordHash   String         @map("password_hash") @db.VarChar(255)
  phone         String         @unique @db.VarChar(32)
  displayName   String         @map("display_name") @db.VarChar(120)
  role          UserRole       @default(user)
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")
  sellerProfile SellerProfile?
  bids          Bid[]

  @@map("users")
}

model SellerProfile {
  id                String        @id @default(uuid()) @db.Uuid
  userId            String        @unique @map("user_id") @db.Uuid
  slug              String        @unique @db.VarChar(120)
  sellerType        SellerType    @map("seller_type")
  storeName         String        @map("store_name") @db.VarChar(160)
  country           String        @db.VarChar(80)
  contactPreference String        @map("contact_preference") @db.VarChar(40)
  socialLink        String?       @map("social_link") @db.VarChar(255)
  shortDescription  String?       @map("short_description") @db.Text
  status            SellerStatus  @default(draft)
  createdAt         DateTime      @default(now()) @map("created_at")
  updatedAt         DateTime      @updatedAt @map("updated_at")
  user              User          @relation(fields: [userId], references: [id], onDelete: Restrict)
  lots              Lot[]
  auctions          Auction[]

  @@map("seller_profiles")
}

model Category {
  id          String  @id @default(uuid()) @db.Uuid
  slug        String  @unique @db.VarChar(120)
  name        String  @db.VarChar(160)
  description String? @db.Text
  lots        Lot[]

  @@map("categories")
}

model Lot {
  id              String        @id @default(uuid()) @db.Uuid
  sellerProfileId String        @map("seller_profile_id") @db.Uuid
  categoryId      String        @map("category_id") @db.Uuid
  title           String        @db.VarChar(200)
  description     String        @db.Text
  condition       String        @db.VarChar(120)
  images          String[]      @default([])
  status          LotStatus     @default(draft)
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")
  sellerProfile   SellerProfile @relation(fields: [sellerProfileId], references: [id], onDelete: Restrict)
  category        Category      @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  auctions        Auction[]

  @@map("lots")
}

model Auction {
  id              String        @id @default(uuid()) @db.Uuid
  lotId           String        @map("lot_id") @db.Uuid
  sellerProfileId String        @map("seller_profile_id") @db.Uuid
  slug            String        @unique @db.VarChar(160)
  startPrice      Decimal       @map("start_price") @db.Decimal(12, 2)
  reservePrice    Decimal       @map("reserve_price") @db.Decimal(12, 2)
  currentPrice    Decimal       @map("current_price") @db.Decimal(12, 2)
  currency        String        @db.Char(3)
  bidStep         Decimal       @map("bid_step") @db.Decimal(12, 2)
  startsAt        DateTime      @map("starts_at")
  endsAt          DateTime      @map("ends_at")
  status          AuctionStatus @default(draft)
  bidCount        Int           @default(0) @map("bid_count")
  winnerBidId     String?       @unique @map("winner_bid_id") @db.Uuid
  buyNowPrice     Decimal?      @map("buy_now_price") @db.Decimal(12, 2)
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")
  lot             Lot           @relation(fields: [lotId], references: [id], onDelete: Restrict)
  sellerProfile   SellerProfile @relation(fields: [sellerProfileId], references: [id], onDelete: Restrict)
  winnerBid       Bid?          @relation("AuctionWinnerBid", fields: [winnerBidId], references: [id], onDelete: SetNull)
  bids            Bid[]

  @@index([status, endsAt])
  @@map("auctions")
}

model Bid {
  id             String    @id @default(uuid()) @db.Uuid
  auctionId      String    @map("auction_id") @db.Uuid
  bidderUserId    String    @map("bidder_user_id") @db.Uuid
  amount         Decimal   @db.Decimal(12, 2)
  status         BidStatus @default(active)
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  auction        Auction   @relation(fields: [auctionId], references: [id], onDelete: Cascade)
  bidderUser     User      @relation(fields: [bidderUserId], references: [id], onDelete: Restrict)
  winningAuction Auction?  @relation("AuctionWinnerBid")

  @@index([auctionId, createdAt])
  @@map("bids")
}
