generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum SellerProfileStatus {
  DRAFT
  APPROVED
  SUSPENDED
}

enum ProductStatus {
  DRAFT
  APPROVED
  ARCHIVED
}

enum ListingType {
  AUCTION
}

enum ListingStatus {
  DRAFT
  SCHEDULED
  LIVE
  ENDED
  CANCELLED
}

enum OrderStatus {
  PENDING_CONTACT
  COMPLETED
  CANCELLED
}

enum OrderCancellationReason {
  BUYER_DECLINED
  BUYER_UNREACHABLE
  ADMIN_CANCELLED
}

model User {
  id              String   @id @default(uuid()) @db.Uuid
  email           String   @unique @db.VarChar(255)
  passwordHash    String   @map("password_hash") @db.VarChar(255)
  phone           String   @unique @db.VarChar(32)
  phoneVerifiedAt DateTime? @map("phone_verified_at")
  displayName     String   @map("display_name") @db.VarChar(120)
  role            String   @default("user")
  status          String   @default("active")
  sessionVersion  Int      @default(0) @map("session_version")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")
  sellerProfile   SellerProfile?
  bids            Bid[]
  buyerOrders     Order[] @relation("OrderBuyer")
  sellerOrders    Order[] @relation("OrderSeller")
  phoneCodes      PhoneVerificationCode[]

  @@map("users")
}

model SellerProfile {
  id                String              @id @default(uuid()) @db.Uuid
  userId            String              @unique @map("user_id") @db.Uuid
  slug              String              @unique @db.VarChar(120)
  sellerType        String              @map("seller_type")
  storeName         String              @map("store_name") @db.VarChar(160)
  country           String              @db.VarChar(80)
  contactPreference String              @map("contact_preference") @db.VarChar(40)
  socialLink        String?             @map("social_link") @db.VarChar(255)
  shortDescription  String?             @map("short_description") @db.Text
  status            SellerProfileStatus @default(DRAFT)
  createdAt         DateTime            @default(now()) @map("created_at")
  updatedAt         DateTime            @updatedAt @map("updated_at")
  user              User                @relation(fields: [userId], references: [id], onDelete: Restrict)
  products          Product[]

  @@map("seller_profiles")
}

model Category {
  id          String    @id @default(uuid()) @db.Uuid
  slug        String    @unique @db.VarChar(120)
  name        String    @db.VarChar(160)
  description String?   @db.Text
  products    Product[]

  @@map("categories")
}

model Product {
  id              String        @id @default(uuid()) @db.Uuid
  publicId        String        @unique @map("public_id") @db.VarChar(16)
  sellerProfileId String        @map("seller_profile_id") @db.Uuid
  categoryId      String?       @map("category_id") @db.Uuid
  title           String?       @db.VarChar(200)
  story           String?       @db.Text
  technique       String?       @db.Text
  materials       String?       @db.Text
  dimensions      String?       @db.VarChar(240)
  weight          String?       @db.VarChar(120)
  year            Int?
  condition       String?       @db.VarChar(120)
  uniqueness      String?       @db.VarChar(240)
  provenance      String?       @db.Text
  city            String?       @db.VarChar(160)
  deliveryInfo    String?       @map("delivery_info") @db.Text
  status          ProductStatus @default(DRAFT)
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")
  sellerProfile   SellerProfile @relation(fields: [sellerProfileId], references: [id], onDelete: Restrict)
  category        Category?     @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  images          ProductImage[]
  listings        Listing[]

  @@index([sellerProfileId, status])
  @@map("products")
}

model ProductImage {
  id         String   @id @default(uuid()) @db.Uuid
  productId  String   @map("product_id") @db.Uuid
  position   Int
  mimeType   String   @map("mime_type") @db.VarChar(100)
  byteLength Int      @map("byte_length")
  data       Bytes
  checksum   String   @db.Char(64)
  createdAt  DateTime @default(now()) @map("created_at")
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@unique([productId, position])
  @@map("product_images")
}

model Listing {
  id             String        @id @default(uuid()) @db.Uuid
  productId      String        @map("product_id") @db.Uuid
  type           ListingType   @default(AUCTION)
  status         ListingStatus @default(DRAFT)
  currency       String        @default("BYN") @db.Char(3)
  startsAt       DateTime      @map("starts_at")
  originalEndsAt DateTime      @map("original_ends_at")
  endsAt         DateTime      @map("ends_at")
  currentPrice   Decimal       @map("current_price") @db.Decimal(12, 2)
  bidCount       Int           @default(0) @map("bid_count")
  closedAt       DateTime?     @map("closed_at")
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")
  product        Product       @relation(fields: [productId], references: [id], onDelete: Restrict)
  auctionRules   AuctionRules?
  bids           Bid[]
  orders         Order[]

  @@index([status, startsAt])
  @@index([status, endsAt])
  @@map("listings")
}

model AuctionRules {
  listingId                    String   @id @map("listing_id") @db.Uuid
  startPrice                   Decimal  @map("start_price") @db.Decimal(12, 2)
  incrementPolicyCode          String   @default("MVP_BYN_V1") @map("increment_policy_code") @db.VarChar(40)
  softCloseWindowSeconds       Int      @default(60) @map("soft_close_window_seconds")
  softCloseExtensionSeconds    Int      @default(60) @map("soft_close_extension_seconds")
  softCloseMaxTotalSeconds     Int      @default(600) @map("soft_close_max_total_seconds")
  listing                      Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@map("auction_rules")
}

model Bid {
  id             String   @id @default(uuid()) @db.Uuid
  listingId      String   @map("listing_id") @db.Uuid
  bidderUserId   String   @map("bidder_user_id") @db.Uuid
  idempotencyKey String   @map("idempotency_key") @db.VarChar(80)
  amount         Decimal  @db.Decimal(12, 2)
  createdAt      DateTime @default(now()) @map("created_at")
  listing        Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  bidderUser     User     @relation(fields: [bidderUserId], references: [id], onDelete: Restrict)
  sourceOrder    Order?

  @@unique([bidderUserId, idempotencyKey])
  @@index([listingId, amount, createdAt, id])
  @@index([listingId, createdAt])
  @@map("bids")
}

model Order {
  id                 String                   @id @default(uuid()) @db.Uuid
  publicId           String                   @unique @map("public_id") @db.VarChar(16)
  listingId          String                   @map("listing_id") @db.Uuid
  sellerId           String                   @map("seller_id") @db.Uuid
  buyerId            String                   @map("buyer_id") @db.Uuid
  sourceBidId        String                   @unique @map("source_bid_id") @db.Uuid
  finalAmount        Decimal                  @map("final_amount") @db.Decimal(12, 2)
  contactDueAt       DateTime                 @map("contact_due_at")
  status             OrderStatus              @default(PENDING_CONTACT)
  cancellationReason OrderCancellationReason? @map("cancellation_reason")
  createdAt          DateTime                 @default(now()) @map("created_at")
  updatedAt          DateTime                 @updatedAt @map("updated_at")
  listing            Listing                  @relation(fields: [listingId], references: [id], onDelete: Restrict)
  seller             User                     @relation("OrderSeller", fields: [sellerId], references: [id], onDelete: Restrict)
  buyer              User                     @relation("OrderBuyer", fields: [buyerId], references: [id], onDelete: Restrict)
  sourceBid          Bid                      @relation(fields: [sourceBidId], references: [id], onDelete: Restrict)

  @@index([listingId])
  @@index([sellerId, status])
  @@index([buyerId, status])
  @@map("orders")
}

model PhoneVerificationCode {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  codeHash  String   @map("code_hash") @db.Char(64)
  expiresAt DateTime @map("expires_at")
  usedAt    DateTime? @map("used_at")
  attempts  Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("phone_verification_codes")
}
