// Immutable registration-time evidence. Legacy users have no record; never backfill consent.
model RegistrationLegalEvidence {
  userId                  String   @id @map("user_id") @db.Uuid
  agreementVersion        String   @map("agreement_version") @db.VarChar(80)
  agreementAcceptedAt     DateTime @map("agreement_accepted_at")
  privacyVersion          String   @map("privacy_version") @db.VarChar(80)
  privacyAcknowledgedAt   DateTime @map("privacy_acknowledged_at")
  dataConsentVersion      String   @map("data_consent_version") @db.VarChar(80)
  dataConsentedAt         DateTime @map("data_consented_at")
  age18ConfirmedAt        DateTime @map("age_18_confirmed_at")
  // Prevent account deletion from silently erasing evidence retained after the relationship ends.
  // A future erasure/retention workflow must explicitly reconcile this ledger.
  user                    User     @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@map("registration_legal_evidence")
}

