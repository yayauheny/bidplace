enum MediaPurpose {
  WORK_IMAGE
  AUTHOR_PHOTO
  ACHIEVEMENT
  LEGACY_CREATION_STEP
  STORY_IMAGE
}
enum MediaProvenance {
  NORMALIZED
  ORIGINAL
  LEGACY_NORMALIZED
}
enum MediaTier {
  PRIVATE
  PUBLIC
}
enum MediaVariant {
  SOURCE
  PREVIEW
  FULL
}
enum MediaAssetState {
  STAGING
  READY
  FAILED
}
enum MediaObjectState {
  PLANNED
  READY
  DELETE_PENDING
  DELETED
}
enum MediaOperationKind {
  UPLOAD
  PUBLISH
  REVOKE
  CLEANUP
}
enum MediaOperationState {
  PENDING
  RUNNING
  FAILED
  DONE
  CANCELLED
}
model MediaAsset {
  id String @id @default(uuid()) @db.Uuid
  ownerUserId String @map("owner_user_id") @db.Uuid
  purpose MediaPurpose
  sourceProvenance MediaProvenance @default(ORIGINAL) @map("source_provenance")
  state MediaAssetState @default(STAGING)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  owner User @relation(fields: [ownerUserId], references: [id], onDelete: Restrict)
  objects MediaObject[]
  profilePhotos SellerProfile[]
  revisionPhotos SellerProfileRevision[]
  achievements SellerProfileRevisionAchievement[]
  images ProductImage[]
  creationSteps ProductCreationStep[]
  storyBlocks ProductRevisionStoryBlock[]
  storyAssets ProductRevisionStoryAsset[]
  @@map("media_assets")
}
model MediaObject {
  id String @id @default(uuid()) @db.Uuid
  assetId String @map("asset_id") @db.Uuid
  variant MediaVariant
  tier MediaTier
  pipelineVersion String @map("pipeline_version") @db.VarChar(16)
  objectKey String @map("object_key") @db.VarChar(255)
  mimeType String @map("mime_type") @db.VarChar(100)
  byteLength Int @map("byte_length")
  sha256 String @db.Char(64)
  width Int
  height Int
  publicUrl String? @map("public_url") @db.VarChar(1024)
  state MediaObjectState @default(PLANNED)
  leaseToken String? @map("lease_token") @db.Uuid
  leaseUntil DateTime? @map("lease_until")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  asset MediaAsset @relation(fields: [assetId], references: [id], onDelete: Restrict)
  manifests MediaOperationObject[]
  @@unique([tier, objectKey])
  @@unique([assetId, variant, tier, pipelineVersion])
  @@map("media_objects")
}
model MediaOperation {
  photoResult Json? @map("photo_result") @db.JsonB
  photoRequestChecksum String? @map("photo_request_checksum") @db.Char(64)
  id String @id @default(uuid()) @db.Uuid
  kind MediaOperationKind
  state MediaOperationState @default(PENDING)
  identity String @unique @db.VarChar(255)
  inputChecksum String? @map("input_checksum") @db.Char(64)
  profileId String? @map("profile_id") @db.Uuid
  productId String? @map("product_id") @db.Uuid
  revisionId String? @map("revision_id") @db.Uuid
  expectedRevisionAt DateTime? @map("expected_revision_at")
  restore Boolean @default(false)
  generation Int @default(0)
  previousRevisionId String? @map("previous_revision_id") @db.Uuid
  actorUserId String? @map("actor_user_id") @db.Uuid
  attemptCount Int @default(0) @map("attempt_count")
  nextAttemptAt DateTime @default(now()) @map("next_attempt_at")
  leaseUntil DateTime? @map("lease_until")
  leaseToken String? @map("lease_token") @db.Uuid
  errorCode String? @map("error_code") @db.VarChar(100)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  profile SellerProfile? @relation(fields: [profileId], references: [id], onDelete: SetNull)
  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  objects MediaOperationObject[]
  @@index([state, nextAttemptAt])
  @@index([profileId, productId, kind, state])
  @@map("media_operations")
}
model AuthAbuseOperation {
