generator client {
  provider      = "prisma-client"
  output        = "../src/generated/prisma"
  binaryTargets = ["native", "debian-openssl-3.0.x", "linux-arm64-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum SellerProfileStatus {
  DRAFT
  PENDING_REVIEW
  APPROVED
  CHANGES_REQUESTED
  REJECTED
  SUSPENDED
}

enum SellerProfileRevisionStatus {
  DRAFT
  PENDING_REVIEW
  APPROVED
  CHANGES_REQUESTED
  REJECTED
}

enum AuthorApplicationStage {
  CONTACTS
  ABOUT
  ACHIEVEMENTS
}

enum AchievementDatePrecision {
  MONTH
  DAY
}

enum ProductStatus {
  DRAFT
  PENDING_REVIEW
  CHANGES_REQUESTED
  APPROVED
  REJECTED
  ARCHIVED
}

enum ListingType {
  FIXED
  AUCTION
}

enum ListingStatus {
  SCHEDULED
  LIVE
  ENDED
  CANCELLED
}

enum ListingCancelReason {
  AUTHOR_WITHDREW
  ADMIN_REMOVED
}

enum OrderSource {
  AUCTION_WIN
  SECOND_CHANCE
  FIXED_PURCHASE
}

enum OrderStatus {
  OFFERED
  ACTIVE
  COMPLETED
  FAILED
}

enum OrderFailReason {
  BUYER_REFUSED
  BUYER_NO_CONTACT
  BUYER_INVALID_CONTACTS
  SELLER_REFUSED
  OFFER_DECLINED
  OFFER_EXPIRED
  ADMIN_CANCELLED
}

enum FaultSide {
  BUYER
  SELLER
  NONE
}

enum CompletedBy {
  SELLER
  ADMIN
}

enum ReportTarget {
  ORDER
  WORK
  AUTHOR
  USER
}

enum ReportStatus {
  OPEN
  UPHELD
  REJECTED
}

enum NotificationOutboxStatus {
  PENDING
  SENT
  FAILED
}

enum AuditTargetType {
  SELLER_PROFILE
  PRODUCT
  ORDER
  LISTING
  USER
  CATALOG
  REPORT
}

model User {
  id                String                @id @default(uuid()) @db.Uuid
  email             String                @unique @db.VarChar(255)
  passwordHash      String?               @map("password_hash") @db.VarChar(255)
  phone             String?               @unique @db.VarChar(32)
  emailVerifiedAt   DateTime?             @map("email_verified_at")
  phoneVerifiedAt   DateTime?             @map("phone_verified_at")
  contactTelegram   String?               @map("contact_telegram") @db.VarChar(255)
  contactInstagram  String?               @map("contact_instagram") @db.VarChar(255)
  contactVk         String?               @map("contact_vk") @db.VarChar(255)
  contactPhone      String?               @map("contact_phone") @db.VarChar(32)
  displayName       String?               @map("display_name") @db.VarChar(120)
  slug              String?               @unique @db.VarChar(120)
  role              String                @default("user")
  status            String                @default("active")
  sessionVersion    Int                   @default(0) @map("session_version")
  createdAt         DateTime              @default(now()) @map("created_at")
  updatedAt         DateTime              @updatedAt @map("updated_at")
  mediaAssets       MediaAsset[]
  registeredAcquisition AcquisitionAttribution? @relation("RegisteredAcquisition")
  sellerProfile     SellerProfile?
  bids              Bid[]
  listings          Listing[]             @relation("ListingSeller")
  buyerOrders       Order[]               @relation("OrderBuyer")
  sellerOrders      Order[]               @relation("OrderSeller")
  reports           Report[]              @relation("ReportReporter")
  resolvedReports   Report[]              @relation("ReportResolver")
  notificationSettings UserNotificationSettings?
  notificationOutbox NotificationOutbox[]
  favoriteWorks     FavoriteWork[]
  externalIdentities ExternalIdentity[]
  emailCodes        EmailVerificationCode[]
  passwordResetTokens PasswordResetToken[]
  termsAcceptances   TermsAcceptance[]
  registrationLegalEvidence RegistrationLegalEvidence?
  fraudSignals FraudSignal[]
  purchaseHolds PurchaseHold[] @relation("HoldUser")
  releasedPurchaseHolds PurchaseHold[] @relation("HoldReleaser")
  authAbuseOperations AuthAbuseOperation[]
  auditEvents       AuditEvent[]          @relation("AuditActor")
  curatorSelections CuratorSelection[]    @relation("CuratorSelectionActor")
  catalogProposals  CatalogProposal[]     @relation("CatalogProposalAuthor")
  reviewedProposals CatalogProposal[]     @relation("CatalogProposalReviewer")

  @@map("users")
}

model SellerProfile {
  id                  String              @id @default(uuid()) @db.Uuid
  userId              String              @unique @map("user_id") @db.Uuid
  slug                String              @unique @db.VarChar(120)
  sellerType          String              @map("seller_type")
  discipline          String?             @db.VarChar(160)
  fullName            String              @map("full_name") @db.VarChar(160)
  country             String              @db.VarChar(80)
  city                String?             @db.VarChar(160)
  practice            String?             @db.Text
  biography           String?             @db.Text
  profilePhotoMimeType String              @map("profile_photo_mime_type") @db.VarChar(100)
  profilePhotoByteLength Int              @map("profile_photo_byte_length")
  profilePhotoChecksum String              @map("profile_photo_checksum") @db.Char(64)
  profilePhotoObjectKey String?            @map("profile_photo_object_key") @db.VarChar(255)
  profilePhotoData    Bytes               @map("profile_photo_data")
  socialLink          String?             @map("social_link") @db.VarChar(255)
  telegramUrl         String?             @map("telegram_url") @db.VarChar(255)
  instagramUrl        String?             @map("instagram_url") @db.VarChar(255)
  websiteUrl          String?             @map("website_url") @db.VarChar(255)
  publicEmail         String?             @map("public_email") @db.VarChar(254)
  shortDescription    String?             @map("short_description") @db.Text
  showContactsToBuyer Boolean             @default(true) @map("show_contacts_to_buyer")
  status              SellerProfileStatus @default(DRAFT)
  applicationStage    AuthorApplicationStage? @map("application_stage")
  editingRevisionId   String?             @unique @map("editing_revision_id") @db.Uuid
  firstPublishedAt DateTime? @map("first_published_at")
  publishedRevisionId String?             @unique @map("published_revision_id") @db.Uuid
  createdAt           DateTime            @default(now()) @map("created_at")
  updatedAt           DateTime            @updatedAt @map("updated_at")
  user                User                @relation(fields: [userId], references: [id], onDelete: Restrict)
  mediaOperations MediaOperation[]
  products            Product[]
  curatorSelections   CuratorSelection[]  @relation("CuratorSelectionCurator")
  revisions           SellerProfileRevision[] @relation("SellerProfileRevisions")
  editingRevision     SellerProfileRevision? @relation("SellerProfileEditingRevision", fields: [editingRevisionId], references: [id], onDelete: Restrict)
  publishedRevision   SellerProfileRevision? @relation("SellerProfilePublishedRevision", fields: [publishedRevisionId], references: [id], onDelete: Restrict)

  @@map("seller_profiles")
  profilePhotoAssetId String? @map("profile_photo_asset_id") @db.Uuid
  profilePhotoAsset MediaAsset? @relation(fields: [profilePhotoAssetId], references: [id], onDelete: Restrict)
  @@index([profilePhotoAssetId])

}

model SellerProfileRevision {
  id              String              @id @default(uuid()) @db.Uuid
  sellerProfileId String              @map("seller_profile_id") @db.Uuid
  version         Int
  status          SellerProfileRevisionStatus @default(DRAFT)
  slug            String              @db.VarChar(120)
  discipline      String?             @db.VarChar(160)
  fullName        String              @map("full_name") @db.VarChar(160)
  country         String              @db.VarChar(80)
  city            String?             @db.VarChar(160)
  practice        String?             @db.Text
  biography       String?             @db.Text
  socialLink      String?             @map("social_link") @db.VarChar(255)
  telegramUrl     String?             @map("telegram_url") @db.VarChar(255)
  instagramUrl    String?             @map("instagram_url") @db.VarChar(255)
  websiteUrl      String?             @map("website_url") @db.VarChar(255)
  publicEmail     String?             @map("public_email") @db.VarChar(254)
  shortDescription String?             @map("short_description") @db.Text
  profilePhotoMimeType String?         @map("profile_photo_mime_type") @db.VarChar(100)
  profilePhotoByteLength Int?          @map("profile_photo_byte_length")
  profilePhotoChecksum String?         @map("profile_photo_checksum") @db.Char(64)
  profilePhotoObjectKey String?        @map("profile_photo_object_key") @db.VarChar(255)
  profilePhotoData Bytes?              @map("profile_photo_data")
  submittedAt     DateTime?           @map("submitted_at")
  reviewedAt      DateTime?           @map("reviewed_at")
  createdAt       DateTime            @default(now()) @map("created_at")
  updatedAt       DateTime            @updatedAt @map("updated_at")
  sellerProfile   SellerProfile       @relation("SellerProfileRevisions", fields: [sellerProfileId], references: [id], onDelete: Cascade)
  editingFor      SellerProfile?      @relation("SellerProfileEditingRevision")
  publishedFor    SellerProfile?      @relation("SellerProfilePublishedRevision")
  achievements    SellerProfileRevisionAchievement[]
  directions      SellerProfileRevisionDirection[]

  @@unique([sellerProfileId, version])
  @@index([sellerProfileId, status])
  @@index([profilePhotoObjectKey])
  @@map("seller_profile_revisions")
  profilePhotoAssetId String? @map("profile_photo_asset_id") @db.Uuid
  profilePhotoAsset MediaAsset? @relation(fields: [profilePhotoAssetId], references: [id], onDelete: Restrict)
  @@index([profilePhotoAssetId])

}

model SellerProfileRevisionAchievement {
  id          String                @id @default(uuid()) @db.Uuid
  revisionId  String                @map("revision_id") @db.Uuid
  position    Int
  occurredAt  DateTime?             @map("occurred_at")
  occurredAtPrecision AchievementDatePrecision? @map("occurred_at_precision")
  body        String                @db.Text
  mimeType    String?               @map("mime_type") @db.VarChar(100)
  byteLength  Int?                  @map("byte_length")
  checksum    String?               @db.Char(64)
  objectKey   String?               @map("object_key") @db.VarChar(255)
  data        Bytes?
  createdAt   DateTime              @default(now()) @map("created_at")
  revision    SellerProfileRevision @relation(fields: [revisionId], references: [id], onDelete: Cascade)

  @@unique([revisionId, position])
  @@index([objectKey])
  @@map("seller_profile_revision_achievements")
  mediaAssetId String? @map("media_asset_id") @db.Uuid
  mediaAsset MediaAsset? @relation(fields: [mediaAssetId], references: [id], onDelete: Restrict)
  @@index([mediaAssetId])

}

model Category {
  id          String    @id @default(uuid()) @db.Uuid
  slug        String    @unique @db.VarChar(120)
  name        String    @db.VarChar(160)
  normalizedName String @map("normalized_name") @db.VarChar(160)
  description String?   @db.Text
  active      Boolean   @default(true)
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  products    Product[]
  productRevisions ProductRevision[]
  directions  SellerProfileRevisionDirection[]
  mappedProposals CatalogProposal[] @relation("MappedProposalCategory")

  @@unique([normalizedName])
  @@map("categories")
}

model Product {
  id              String        @id @default(uuid()) @db.Uuid
  publicId        String        @unique @map("public_id") @db.VarChar(16)
  sellerProfileId String        @map("seller_profile_id") @db.Uuid
  categoryId      String?       @map("category_id") @db.Uuid
  title           String?       @db.VarChar(200)
  story           String?       @db.Text
  technique       String?       @db.Text
  materials       String?       @db.Text
  dimensions      String?       @db.VarChar(240)
  weight          String?       @db.VarChar(120)
  year            Int?
  condition       String?       @db.VarChar(120)
  uniqueness      String?       @db.VarChar(240)
  provenance      String?       @db.Text
  city            String?       @db.VarChar(160)
  packaging       String?       @db.Text
  deliveryInfo    String?       @map("delivery_info") @db.Text
  creationIntro   String?       @map("creation_intro") @db.Text
  publishedAt     DateTime?     @map("published_at")
  status          ProductStatus @default(DRAFT)
  editingRevisionId String?     @unique @map("editing_revision_id") @db.Uuid
  publishedRevisionId String?   @unique @map("published_revision_id") @db.Uuid
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")
  sellerProfile   SellerProfile @relation(fields: [sellerProfileId], references: [id], onDelete: Restrict)
  category        Category?     @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  mediaOperations MediaOperation[]
  images          ProductImage[]
  creationSteps   ProductCreationStep[]
  listings        Listing[]
  orders          Order[]
  favoriteWorks   FavoriteWork[]
  revisions       ProductRevision[] @relation("ProductRevisions")
  editingRevision ProductRevision? @relation("ProductEditingRevision", fields: [editingRevisionId], references: [id], onDelete: Restrict)
  publishedRevision ProductRevision? @relation("ProductPublishedRevision", fields: [publishedRevisionId], references: [id], onDelete: Restrict)
  curatorSelection  CuratorSelection?

  @@index([sellerProfileId, status])
  @@map("products")
}

model ProductRevision {
  id            String        @id @default(uuid()) @db.Uuid
  productId     String        @map("product_id") @db.Uuid
  version       Int
  status        ProductStatus @default(DRAFT)
  categoryId    String?       @map("category_id") @db.Uuid
  category      Category?     @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  title         String?       @db.VarChar(200)
  story         String?       @db.Text
  technique     String?       @db.Text
  materials     String?       @db.Text
  dimensions    String?       @db.VarChar(240)
  weight        String?       @db.VarChar(120)
  year          Int?
  condition     String?       @db.VarChar(120)
  uniqueness    String?       @db.VarChar(240)
  provenance    String?       @db.Text
  city          String?       @db.VarChar(160)
  packaging     String?       @db.Text
  deliveryInfo  String?       @map("delivery_info") @db.Text
  creationIntro String?       @map("creation_intro") @db.Text
  submittedAt   DateTime?     @map("submitted_at")
  reviewedAt    DateTime?     @map("reviewed_at")
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")
  product       Product       @relation("ProductRevisions", fields: [productId], references: [id], onDelete: Cascade)
  editingFor    Product?      @relation("ProductEditingRevision")
  publishedFor  Product?      @relation("ProductPublishedRevision")
  images        ProductRevisionImage[]
  terms         ProductRevisionTerm[]
  proposals     CatalogProposal[]
  storyBlocks   ProductRevisionStoryBlock[]
  storyAssets   ProductRevisionStoryAsset[]
  storyToken    Int           @default(0) @map("story_token")
  storyIdempotencyKey String? @map("story_idempotency_key") @db.VarChar(80)

  @@unique([productId, version])
  @@index([productId, status])
  @@map("product_revisions")
}

model ProductImage {
  uploadIdentity String? @unique @map("upload_identity") @db.Char(64)
  inputChecksum String? @map("input_checksum") @db.Char(64)
  id         String   @id @default(uuid()) @db.Uuid
  productId  String   @map("product_id") @db.Uuid
  position   Int
  mimeType   String   @map("mime_type") @db.VarChar(100)
  byteLength Int      @map("byte_length")
  objectKey  String?  @map("object_key") @db.VarChar(255)
  data       Bytes
  checksum   String   @db.Char(64)
  width      Int?
  height     Int?
  createdAt  DateTime @default(now()) @map("created_at")
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  revisions  ProductRevisionImage[]

  @@index([productId])
  @@unique([productId, position])
  @@map("product_images")
  mediaAssetId String? @map("media_asset_id") @db.Uuid
  mediaAsset MediaAsset? @relation(fields: [mediaAssetId], references: [id], onDelete: Restrict)
  @@index([mediaAssetId])

}

model ProductRevisionImage {
  slotId String @unique @default(dbgenerated("gen_random_uuid()")) @map("slot_id") @db.Uuid
  version Int @default(0)
  crop Json? @db.JsonB
  operationKey String? @map("operation_key") @db.Char(64)
  operationChecksum String? @map("operation_checksum") @db.Char(64)
  revisionId String          @map("revision_id") @db.Uuid
  imageId    String          @map("image_id") @db.Uuid
  position   Int
  revision   ProductRevision @relation(fields: [revisionId], references: [id], onDelete: Cascade)
  image      ProductImage    @relation(fields: [imageId], references: [id], onDelete: Restrict)

  @@id([revisionId, imageId])
  @@unique([revisionId, position])
  @@index([imageId])
  @@map("product_revision_images")
}

model ProductCreationStep {
  id         String   @id @default(uuid()) @db.Uuid
  productId  String   @map("product_id") @db.Uuid
  position   Int
  title      String   @db.VarChar(200)
  body       String   @db.Text
  mimeType   String?  @map("mime_type") @db.VarChar(100)
  byteLength Int?     @map("byte_length")
  objectKey  String?  @map("object_key") @db.VarChar(255)
  data       Bytes?
  checksum   String?  @db.Char(64)
  width      Int?
  height     Int?
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, position])
  @@index([productId])
  @@map("product_creation_steps")
  mediaAssetId String? @map("media_asset_id") @db.Uuid
  mediaAsset MediaAsset? @relation(fields: [mediaAssetId], references: [id], onDelete: Restrict)
  @@index([mediaAssetId])

}

model Listing {
  id                 String               @id @default(uuid()) @db.Uuid
  productId          String               @map("product_id") @db.Uuid
  sellerUserId       String               @map("seller_user_id") @db.Uuid
  type               ListingType
  status             ListingStatus
  currency           String               @db.Char(3)
  priceMinor         Int?                 @map("price_minor")
  startsAt           DateTime             @map("starts_at")
  endsAt             DateTime?            @map("ends_at")
  originalEndsAt     DateTime?            @map("original_ends_at")
  contactWindowHours Int                  @default(24) @map("contact_window_hours")
  currentPriceMinor  Int?                 @map("current_price_minor")
  bidCount           Int                  @default(0) @map("bid_count")
  cancelReason       ListingCancelReason? @map("cancel_reason")
  endedAt            DateTime?            @map("ended_at")
  cancelledAt        DateTime?            @map("cancelled_at")
  createdAt          DateTime             @default(now()) @map("created_at")
  product            Product              @relation(fields: [productId], references: [id], onDelete: Restrict)
  seller             User                 @relation("ListingSeller", fields: [sellerUserId], references: [id], onDelete: Restrict)
  auctionRules       AuctionRules?
  bids               Bid[]
  orders             Order[]

  @@index([status, startsAt])
  @@index([status, endsAt])
  @@index([productId])
  @@map("listings")
}

model AuctionRules {
  listingId                 String  @id @map("listing_id") @db.Uuid
  startPriceMinor           Int     @map("start_price_minor")
  stepTableCode             String  @map("step_table_code") @db.VarChar(20)
  softCloseWindowSeconds    Int     @default(60) @map("soft_close_window_seconds")
  softCloseExtensionSeconds Int     @default(60) @map("soft_close_extension_seconds")
  softCloseMaxTotalSeconds  Int     @default(600) @map("soft_close_max_total_seconds")
  listing                   Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@map("auction_rules")
}

model Bid {
  id             String    @id @default(uuid()) @db.Uuid
  listingId      String    @map("listing_id") @db.Uuid
  bidderUserId   String    @map("bidder_user_id") @db.Uuid
  amountMinor    Int       @map("amount_minor")
  idempotencyKey String    @map("idempotency_key") @db.VarChar(100)
  createdAt      DateTime  @default(now()) @map("created_at")
  voidedAt       DateTime? @map("voided_at")
  voidReason     String?   @map("void_reason") @db.VarChar(40)
  listing        Listing   @relation(fields: [listingId], references: [id], onDelete: Cascade)
  bidderUser     User      @relation(fields: [bidderUserId], references: [id], onDelete: Restrict)
  sourceOrder    Order?

  @@unique([listingId, bidderUserId, idempotencyKey])
  @@index([listingId, amountMinor])
  @@map("bids")
}

model Order {
  id                    String           @id @default(uuid()) @db.Uuid
  publicId              String           @unique @map("public_id") @db.VarChar(16)
  dealCode              String           @map("deal_code") @db.Char(6)
  productId             String           @map("product_id") @db.Uuid
  listingId             String           @map("listing_id") @db.Uuid
  sellerUserId          String           @map("seller_user_id") @db.Uuid
  buyerUserId           String           @map("buyer_user_id") @db.Uuid
  source                OrderSource
  sourceBidId           String?          @unique @map("source_bid_id") @db.Uuid
  amountMinor           Int              @map("amount_minor")
  currency              String           @db.Char(3)
  status                OrderStatus
  failReason            OrderFailReason? @map("fail_reason")
  faultSide             FaultSide?       @map("fault_side")
  strikeVoidedAt        DateTime?        @map("strike_voided_at")
  completedBy           CompletedBy?     @map("completed_by")
  offerExpiresAt        DateTime?        @map("offer_expires_at")
  activatedAt           DateTime?        @map("activated_at")
  contactDeadlineAt     DateTime?        @map("contact_deadline_at")
  sellerRemindersSent   Int              @default(0) @map("seller_reminders_sent")
  completedAt           DateTime?        @map("completed_at")
  failedAt              DateTime?        @map("failed_at")
  buyerComment          String?          @map("buyer_comment") @db.VarChar(500)
  sellerNote            String?          @map("seller_note") @db.VarChar(1000)
  workTitleSnapshot     String           @map("work_title_snapshot") @db.VarChar(200)
  workPublicIdSnapshot  String           @map("work_public_id_snapshot") @db.VarChar(16)
  coverImageIdSnapshot  String?          @map("cover_image_id_snapshot") @db.Uuid
  sellerNameSnapshot    String           @map("seller_name_snapshot") @db.VarChar(160)
  createdAt             DateTime         @default(now()) @map("created_at")
  updatedAt             DateTime         @updatedAt @map("updated_at")
  product               Product          @relation(fields: [productId], references: [id], onDelete: Restrict)
  listing               Listing          @relation(fields: [listingId], references: [id], onDelete: Restrict)
  seller                User             @relation("OrderSeller", fields: [sellerUserId], references: [id], onDelete: Restrict)
  buyer                 User             @relation("OrderBuyer", fields: [buyerUserId], references: [id], onDelete: Restrict)
  sourceBid             Bid?             @relation(fields: [sourceBidId], references: [id], onDelete: Restrict)

  @@index([buyerUserId, status])
  @@index([sellerUserId, status])
  @@index([status, activatedAt])
  @@index([status, offerExpiresAt])
  @@map("orders")
}

model Report {
  id             String        @id @default(uuid()) @db.Uuid
  targetType     ReportTarget  @map("target_type")
  targetId       String        @map("target_id") @db.Uuid
  reporterUserId String        @map("reporter_user_id") @db.Uuid
  reason         String        @db.VarChar(40)
  text           String?       @db.VarChar(1000)
  status         ReportStatus  @default(OPEN)
  faultSide      FaultSide?    @map("fault_side")
  adminNote      String?       @map("admin_note") @db.VarChar(2000)
  resolvedAt     DateTime?     @map("resolved_at")
  resolvedById   String?       @map("resolved_by_id") @db.Uuid
  createdAt      DateTime      @default(now()) @map("created_at")
  reporter       User          @relation("ReportReporter", fields: [reporterUserId], references: [id], onDelete: Restrict)
  resolvedBy     User?         @relation("ReportResolver", fields: [resolvedById], references: [id], onDelete: Restrict)

  @@index([status, createdAt])
  @@index([targetType, targetId])
  @@map("reports")
}

model UserNotificationSettings {
  userId      String   @id @map("user_id") @db.Uuid
  outbidEmail Boolean  @default(true) @map("outbid_email")
  updatedAt   DateTime @updatedAt @map("updated_at")
  user        User     @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@map("user_notification_settings")
}

model NotificationOutbox {
  id            String                   @id @default(uuid()) @db.Uuid
  userId        String                   @map("user_id") @db.Uuid
  kind          String                   @db.VarChar(40)
  payload       Json
  status        NotificationOutboxStatus @default(PENDING)
  attemptCount  Int                      @default(0) @map("attempt_count")
  nextAttemptAt DateTime                 @map("next_attempt_at")
  sentAt        DateTime?                @map("sent_at")
  createdAt     DateTime                 @default(now()) @map("created_at")
