model CatalogProposal {
  id                String                @id @default(uuid()) @db.Uuid
  authorUserId      String                @map("author_user_id") @db.Uuid
  productRevisionId String                @map("product_revision_id") @db.Uuid
  kind              CatalogProposalKind
  rawName           String                @map("raw_name") @db.VarChar(160)
  normalizedName    String                @map("normalized_name") @db.VarChar(160)
  status            CatalogProposalStatus @default(PENDING)
  selected          Boolean               @default(true)
  mappedCategoryId  String?               @map("mapped_category_id") @db.Uuid
  mappedTermId      String?               @map("mapped_term_id") @db.Uuid
  rejectionReason   String?               @map("rejection_reason") @db.Text
  reviewedByUserId  String?               @map("reviewed_by_user_id") @db.Uuid
  reviewedAt        DateTime?             @map("reviewed_at")
  createdAt         DateTime              @default(now()) @map("created_at")
  updatedAt         DateTime              @updatedAt @map("updated_at")
  author            User                  @relation("CatalogProposalAuthor", fields: [authorUserId], references: [id], onDelete: Restrict)
  reviewer          User?                 @relation("CatalogProposalReviewer", fields: [reviewedByUserId], references: [id], onDelete: Restrict)
  revision          ProductRevision       @relation(fields: [productRevisionId], references: [id], onDelete: Cascade)
  mappedCategory    Category?             @relation("MappedProposalCategory", fields: [mappedCategoryId], references: [id], onDelete: Restrict)
  mappedTerm        CatalogTerm?          @relation("MappedProposalTerm", fields: [mappedTermId], references: [id], onDelete: Restrict)

  @@unique([productRevisionId, kind, normalizedName])
  @@index([productRevisionId, status, selected])
  @@index([kind, normalizedName, status])
  @@map("catalog_proposals")
}

